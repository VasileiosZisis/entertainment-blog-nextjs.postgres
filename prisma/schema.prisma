generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum BlogCategory {
  GAME  @map("game")
  TV    @map("tv")
  BOOK  @map("book")
  ANIME @map("anime")

  @@map("blog_category")
}

enum UpcomingKind {
  READING  @map("Reading")
  WATCHING @map("Watching")
  PLAYING  @map("Playing")

  @@map("upcoming_kind")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  isAdmin      Boolean  @default(false) @map("is_admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model BlogPost {
  id            String       @id @default(cuid())
  title         String       @db.VarChar(80)
  subtitle      String       @db.VarChar(140)
  slug          String       @unique
  content       String       @db.Text
  category      BlogCategory
  imageUrl      String       @map("image_url") @db.Text
  imagePublicId String       @map("image_public_id")
  imageAlt      String       @map("image_alt") @db.VarChar(180)
  published     Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([category, createdAt])
  @@index([published, createdAt])
  @@map("blog_posts")
}

model Upcoming {
  id            String       @id @default(cuid())
  kind          UpcomingKind
  subtitle      String       @db.VarChar(120)
  imageUrl      String       @map("image_url") @db.Text
  imagePublicId String       @unique @map("image_public_id")
  imageAlt      String       @map("image_alt") @db.VarChar(180)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([kind])
  @@map("upcoming")
}
